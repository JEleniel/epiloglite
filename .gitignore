########################################################################
# Rust / build artifacts
########################################################################

# Cargo build output
target/

# Rust incremental compilation and metadata
incremental/
*.rlib
*.rmeta

# Generated profiling and debug artifacts
*.profraw
*.dSYM/

# Cargo fingerprint cache (tooling)
.fingerprint/

# Compiled dynamic libraries and executables (built artifacts)
# Editors, IDEs, and local tooling
########################################################################

# rust-analyzer / other analysis caches
.rust-analyzer/
.rust-analysis/
.analyze/

# VS Code
.vscode/
# keep these project-friendly workspace files if checked in
!.vscode/*.code-snippets
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.*.json
!.vscode/settings.json
!.vscode/tasks.json

# History / test helpers
.history/
.vscode-test

########################################################################
# Additional IDEs and editors
########################################################################

# JetBrains IDEs (IntelliJ, CLion, GoLand, etc.)
.idea/
*.iml
*.iws
*.ipr

# Eclipse/Java project files
.classpath
.project
.settings/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim swap / backup files
*.swp
*.swo
*.swn

# Emacs auto-save files
# e.g. #foo# and .#foo
# keep *~ already present; add emacs autosave patterns
# (the leading and trailing hashes are literal characters in filenames)
# NOTE: gitignore treats the patterns literally; these are common editor files
# Emacs autosave
#*#
.#*

########################################################################
# Agents and prompts (local-only)
########################################################################

.prompts/

########################################################################
# Archives, packages and installers
########################################################################

*.7z
*.bz2
*.bzip
*.bzip2
*.cab
*.deb
*.dmg
*.egg
*.gem
*.gz
*.gzip
*.iso
*.jar
*.lzma
*.msi
*.msix
*.msm
*.msp
*.rar
*.rpm
*.tar
*.tgz
*.txz
*.tzst
*.xar
*.xpi
*.xz
*.zip
*.zst

########################################################################
# Binary/compiled dynamic libraries and executables
########################################################################

*.dll
*.dylib
*.so
*.exe

########################################################################
# Backup, diff and patch files
########################################################################

*.bak
*.gho
*.ori
*.orig
*.diff
*.patch

########################################################################
# Temporary, cache and runtime files
########################################################################

tmp/
temp/
.temp/
.cache/
*.tmp
*.rej

# Editor backup files
*~

########################################################################
# OS-specific files
########################################################################

# Linux
.directory
.fuse_hidden*
.nfs*
.Trash-*

# Windows
$RECYCLE.BIN/
[Dd]esktop.ini
ehthumbs.db
ehthumbs_vista.db
*.lnk
*.stackdump
Thumbs.db
Thumbs.db:encryptable

# macOS
._*
.apdisk
.AppleDB
.AppleDesktop
.AppleDouble
.com.apple.timemachine.donotpresent
.DocumentRevisions-V100
.DS_Store
.fseventsd
.LSOverride
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
Icon
Network Trash Folder
Temporary Items

########################################################################
# Security and credential files
########################################################################

*.pem
*.key
*.crt
*.cert
*.keystore
*.p12
*.pfx
*.cer
*.der
*.csr
*.crl
*.srl
*.pem1
*.p7b
*.p7s
*.jks
*.keystore
*.truststore

# PGP / GPG
*.gpg
*.asc
*.pgp

# SSH
id_*
id_*.*

# macOS Keychain export
*.keychain


# Environment files (allow example)
.env
.env.*
!.env.example

########################################################################
# Logs and diagnostics
########################################################################

logs/
*.log
*-debug.log*
*-error.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

########################################################################
# PID / runtime state
########################################################################

pids/
*.pid
*.pid.lock
*.seed

